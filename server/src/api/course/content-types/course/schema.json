      "required": true
    },
    "modules": {
      "type": "component",
      "repeatable": true,
      "component": "base.module",
      "required": true
    },
    "goals": {
      "displayName": "Goal",
      "type": "component",
      "repeatable": true,
      "component": "base.goal"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "course"
    }
  }
